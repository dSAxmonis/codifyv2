# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Get from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/codify?retryWrites=true&w=majority

# ── Clerk ─────────────────────────────────────────────────────────────────────
# Get from Clerk Dashboard → API Keys → Secret Key
CLERK_SECRET_KEY=your_clerk_secret_key_here

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Your deployed React app URL (for CORS)
FRONTEND_URL=http://localhost:3000
